<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contact – Samikshya Shrestha</title>
  <meta name="description" content="Get in touch with Samikshya Shrestha – open for internships, collaborations, and AI/web development opportunities." />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg:#0c0c10; --card:#16161d; --card-hover:#1c1c25;
      --text:#ececec; --sub:#b0b0b8; --muted:#6b6b78;
      --accent:#a78bfa; --accent2:#818cf8;
      --border:rgba(255,255,255,0.07);
    }
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
    html{scroll-behavior:smooth;}
    body{
      font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);line-height:1.6;
      background-image:radial-gradient(ellipse 80% 40% at 50% -10%,rgba(167,139,250,0.10) 0%,transparent 70%);
    }
    .container{max-width:1120px;margin:auto;padding:0 2rem;}

    /* NAV */
    header{padding:2rem 0;}
    nav{display:flex;justify-content:center;}
    .nav-container{
      display:flex;padding:0.55rem 1.6rem;border-radius:50px;
      background:rgba(255,255,255,0.03);border:1px solid var(--border);backdrop-filter:blur(12px);
    }
    .nav-links{display:flex;gap:1.5rem;}
    .nav-links a{
      text-decoration:none;color:var(--muted);font-size:0.88rem;
      letter-spacing:0.02em;position:relative;padding-bottom:4px;transition:color 0.25s;
    }
    .nav-links a::after{
      content:"";position:absolute;left:0;bottom:0;width:0%;height:2px;
      background:linear-gradient(90deg,var(--accent),var(--accent2));
      border-radius:2px;transition:width 0.3s ease;
    }
    .nav-links a:hover,.nav-links a.active{color:var(--text);}
    .nav-links a:hover::after,.nav-links a.active::after{width:100%;}
    .nav-links a.active{font-weight:600;}

    /* PAGE */
    main{padding:3.5rem 0 6rem;}
    .page-badge{
      display:inline-flex;align-items:center;gap:0.4rem;
      background:rgba(167,139,250,0.1);border:1px solid rgba(167,139,250,0.22);
      color:var(--accent);padding:0.28rem 0.9rem;border-radius:50px;
      font-size:0.75rem;font-weight:500;letter-spacing:0.06em;
      text-transform:uppercase;margin-bottom:1rem;
    }
    h1{
      font-size:clamp(2rem,5vw,2.8rem);font-weight:800;letter-spacing:-0.03em;
      background:linear-gradient(135deg,#fff 30%,var(--accent) 100%);
      -webkit-background-clip:text;-webkit-text-fill-color:transparent;
      background-clip:text;margin-bottom:0.8rem;
    }
    .page-desc{color:var(--sub);max-width:580px;font-size:1rem;line-height:1.7;margin-bottom:3rem;}

    /* GRID */
    .grid{display:grid;grid-template-columns:1.2fr 0.8fr;gap:2rem;align-items:start;}

    /* CARD */
    .card{
      background:var(--card);
      background-image:linear-gradient(135deg,rgba(255,255,255,0.025) 0%,transparent 60%);
      border:1px solid var(--border);border-radius:20px;padding:2rem;
      transition:background 0.3s,box-shadow 0.3s,transform 0.3s;
    }
    .card:hover{
      background:var(--card-hover);transform:translateY(-4px);
      box-shadow:0 16px 48px rgba(0,0,0,0.5),0 0 0 1px rgba(167,139,250,0.18),0 0 36px rgba(167,139,250,0.07);
    }

    /* FORM */
    .form-label{
      display:block;font-size:0.75rem;font-weight:600;letter-spacing:0.07em;
      text-transform:uppercase;color:var(--accent);margin-bottom:0.4rem;
    }
    .form-group{margin-bottom:1.1rem;}
    input,textarea{
      width:100%;padding:0.8rem 1rem;
      background:rgba(255,255,255,0.04);
      border:1px solid var(--border);border-radius:10px;
      color:var(--text);font-family:inherit;font-size:0.93rem;
      transition:border-color 0.25s,background 0.25s;
    }
    input::placeholder,textarea::placeholder{color:var(--muted);}
    input:focus,textarea:focus{
      outline:none;
      border-color:rgba(167,139,250,0.45);
      background:rgba(167,139,250,0.05);
    }
    textarea{resize:vertical;min-height:120px;}

    button[type="submit"]{
      width:100%;padding:0.85rem;
      background:linear-gradient(135deg,var(--accent),var(--accent2));
      color:#fff;border:none;border-radius:10px;
      font-family:inherit;font-size:0.9rem;font-weight:600;
      cursor:pointer;letter-spacing:0.03em;
      transition:opacity 0.25s,transform 0.25s,box-shadow 0.25s;
    }
    button[type="submit"]:hover{
      opacity:0.88;transform:translateY(-2px);
      box-shadow:0 8px 24px rgba(167,139,250,0.35);
    }

    /* SOCIAL LINKS */
    .social-card{margin-bottom:1rem;}
    .social{
      display:flex;justify-content:space-between;align-items:center;
      padding:1rem 1.2rem;border-radius:14px;
      border:1px solid var(--border);
      background:rgba(255,255,255,0.025);
      text-decoration:none;color:var(--text);
      transition:background 0.25s,border-color 0.25s,transform 0.25s,box-shadow 0.25s;
      margin-bottom:0.75rem;
    }
    .social:hover{
      background:rgba(167,139,250,0.08);
      border-color:rgba(167,139,250,0.25);
      transform:translateX(4px);
      box-shadow:0 4px 16px rgba(0,0,0,0.3);
    }
    .social-name{font-size:0.95rem;font-weight:600;}
    .social-arrow{font-size:0.82rem;color:var(--accent);transition:transform 0.25s;}
    .social:hover .social-arrow{transform:translateX(3px);}

    /* INFO card */
    .info-card{
      background:var(--card);
      background-image:linear-gradient(135deg,rgba(255,255,255,0.025) 0%,transparent 60%);
      border:1px solid var(--border);border-radius:14px;padding:1.4rem 1.6rem;
    }
    .info-label{font-size:0.72rem;font-weight:600;letter-spacing:0.07em;text-transform:uppercase;color:var(--accent);margin-bottom:0.25rem;}
    .info-value{font-size:0.93rem;color:var(--sub);margin-bottom:1rem;}
    .info-value:last-child{margin-bottom:0;}

    /* RESPONSIVE */
    @media(max-width:768px){.grid{grid-template-columns:1fr;}}
    @media(max-width:480px){h1{font-size:2rem;}}
  </style>
</head>
<body>
<div class="container">

  <header>
    <nav>
      <div class="nav-container">
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/projects">Projects</a>
          <a href="/about">About</a>
          <a href="/contact" class="active">Contact</a>
        </div>
      </div>
    </nav>
  </header>

  <main>
    <span class="page-badge">✦ Contact</span>
    <h1>Let's build something together</h1>
    <p class="page-desc">Open for internships, collaborations, and AI/web development opportunities.</p>

    <div class="grid">

      <!-- FORM -->
      <div class="card">
        <form onsubmit="sendMessage(event)">
          <div class="form-group">
            <label class="form-label" for="name">Your Name</label>
            <input id="name" type="text" placeholder="Full Name" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="email">Email Address</label>
            <input id="email" type="email" placeholder="Email Address" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="message">Message</label>
            <textarea id="message" rows="5" placeholder="Your Message" required></textarea>
          </div>
          <button type="submit">Send Message →</button>
        </form>
      </div>

      <!-- SIDEBAR -->
      <div>
        <a class="social" href="https://www.linkedin.com/in/samikshya-shrestha-a49059286/" target="_blank" rel="noopener">
          <span class="social-name">LinkedIn</span>
          <span class="social-arrow">Connect →</span>
        </a>

        <a class="social" href="https://github.com/samikshyaaaaa" target="_blank" rel="noopener">
          <span class="social-name">GitHub</span>
          <span class="social-arrow">Projects →</span>
        </a>

        <div class="info-card">
          <p class="info-label">Email</p>
          <p class="info-value">samikshyashr202@gmail.com</p>
          <p class="info-label">Location</p>
          <p class="info-value">Kathmandu, Nepal</p>
        </div>
      </div>

    </div>
  </main>

</div>

<script is:inline src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
<script is:inline>
  emailjs.init("IsKgV1rSbFfgtjm9F");

  function sendMessage(event) {
    event.preventDefault();
    const params = {
      from_name:  document.getElementById("name").value,
      from_email: document.getElementById("email").value,
      message:    document.getElementById("message").value,
    };
    emailjs.send("service_w3e8ksp", "template_jj8erqo", params)
      .then(() => alert("Message sent successfully!"))
      .catch(err => { console.error(err); alert("Failed to send message. Check console."); });
  }
</script>

</body>
</html>