<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Projects – Samikshya Shrestha</title>
  <meta name="description" content="A curated selection of projects by Samikshya Shrestha, showcasing web development, AI systems, and data analysis work." />

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>

  <style>
    /* ── DESIGN TOKENS ── */
    :root {
      --bg:        #0c0c10;
      --bg2:       #111116;
      --card:      #16161d;
      --card-hover:#1c1c25;
      --text:      #ececec;
      --sub:       #b0b0b8;
      --muted:     #6b6b78;
      --accent:    #a78bfa;
      --accent2:   #818cf8;
      --border:    rgba(255,255,255,0.07);
      --shadow:    0 8px 32px rgba(0,0,0,0.55);
      --glow:      0 0 40px rgba(167,139,250,0.08);
    }

    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      /* subtle radial glow at top */
      background-image:
        radial-gradient(ellipse 80% 40% at 50% -10%, rgba(167,139,250,0.10) 0%, transparent 70%);
    }

    /* ── LAYOUT ── */
    .container {
      max-width: 1120px;
      margin: auto;
      padding: 0 2rem;
    }

    /* ── NAV ── */
    header { padding: 2rem 0; }

    nav { display: flex; justify-content: center; }

    .nav-container {
      display: flex;
      gap: 1.8rem;
      padding: 0.55rem 1.6rem;
      border-radius: 50px;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      backdrop-filter: blur(12px);
    }

    .nav-links { display: flex; gap: 1.5rem; }

    .nav-links a {
      text-decoration: none;
      color: var(--muted);
      font-size: 0.88rem;
      letter-spacing: 0.02em;
      position: relative;
      padding-bottom: 4px;
      transition: color 0.25s;
    }

    .nav-links a::after {
      content: "";
      position: absolute;
      left: 0; bottom: 0;
      width: 0%;
      height: 2px;
      background: linear-gradient(90deg, var(--accent), var(--accent2));
      border-radius: 2px;
      transition: width 0.3s ease;
    }

    .nav-links a:hover,
    .nav-links a.active { color: var(--text); }

    .nav-links a:hover::after,
    .nav-links a.active::after { width: 100%; }

    .nav-links a.active { font-weight: 600; }

    /* ── PAGE HEADER ── */
    main { padding: 3.5rem 0 6rem; }

    .page-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(167,139,250,0.1);
      border: 1px solid rgba(167,139,250,0.22);
      color: var(--accent);
      padding: 0.28rem 0.9rem;
      border-radius: 50px;
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-bottom: 1rem;
    }

    h1 {
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      background: linear-gradient(135deg, #fff 30%, var(--accent) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 0.8rem;
    }

    .page-desc {
      color: var(--sub);
      max-width: 580px;
      font-size: 1rem;
      margin-bottom: 3.5rem;
      line-height: 1.7;
    }

    /* ── PROJECT LIST ── */
    .projects {
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }

    /* ── PROJECT CARD ── */
    .project-card {
      display: grid;
      /* text ~40% | image ~60% */
      grid-template-columns: 2fr 3fr;
      gap: 2.5rem;
      align-items: center;

      background: var(--card);
      background-image: linear-gradient(135deg, rgba(255,255,255,0.025) 0%, transparent 60%);
      padding: 2.2rem 2.4rem;
      border-radius: 22px;
      border: 1px solid var(--border);
      box-shadow: var(--shadow), var(--glow);

      opacity: 0;
      transform: translateY(36px);
      transition: opacity 0.55s ease, transform 0.55s ease, box-shadow 0.3s, background 0.3s;
      will-change: transform, opacity;
    }

    .project-card.show {
      opacity: 1;
      transform: translateY(0);
    }

    .project-card:hover {
      background: var(--card-hover);
      box-shadow: 0 20px 60px rgba(0,0,0,0.65), 0 0 60px rgba(167,139,250,0.10);
      transform: translateY(-5px);
    }

    /* ── TEXT SIDE ── */
    .project-text {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      order: 1; /* text LEFT */
    }

    .project-number {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      opacity: 0.75;
    }

    .project-title {
      font-size: 1.35rem;
      font-weight: 700;
      line-height: 1.3;
      letter-spacing: -0.01em;
      color: var(--text);
    }

    .project-desc {
      color: var(--sub);
      font-size: 0.93rem;
      line-height: 1.75;
    }

    .project-desc p + p {
      margin-top: 0.75rem;
    }

    .project-tech {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 0.3rem;
    }

    .tech-label {
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.03em;
      color: var(--muted);
      background: rgba(255,255,255,0.045);
      border: 1px solid rgba(255,255,255,0.07);
      padding: 0.22rem 0.6rem;
      border-radius: 6px;
      transition: color 0.2s, background 0.2s;
    }

    .tech-label:hover {
      color: var(--accent);
      background: rgba(167,139,250,0.12);
      border-color: rgba(167,139,250,0.25);
    }

    /* ── Z-PATTERN: .reverse flips image left / text right ── */
    .project-card.reverse .project-text        { order: 2; }
    .project-card.reverse .project-image-wrap  { order: 1; }
    /* flip column sizes so image column stays wider on both sides */
    .project-card.reverse { grid-template-columns: 3fr 2fr; }

    /* ── IMAGE SIDE ── */
    .project-image-wrap {
      order: 2; /* image RIGHT by default */
      position: relative;
      border-radius: 18px;
      overflow: hidden;
      /* lock a consistent height; object-fit handles the rest */
      aspect-ratio: 16 / 10;
      box-shadow:
        0 2px 6px  rgba(0,0,0,0.22),
        0 8px 24px rgba(0,0,0,0.42),
        0 20px 48px rgba(0,0,0,0.32),
        0 0 0 1px var(--border);
      transition: box-shadow 0.4s ease;
      background: #0a0a0e;
    }

    /* accent glow on card hover */
    .project-card:hover .project-image-wrap {
      box-shadow:
        0 2px 6px  rgba(0,0,0,0.28),
        0 10px 30px rgba(0,0,0,0.50),
        0 24px 56px rgba(0,0,0,0.38),
        0 0 0 1px rgba(167,139,250,0.28),
        0 0 36px rgba(167,139,250,0.09);
    }

    .project-image-wrap img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;        /* fills frame without distortion */
      object-position: center;  /* always centered on the subject */
      border-radius: 18px;
      cursor: pointer;
      opacity: 0.95;
      transition:
        transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
        opacity   0.3s ease;
    }

    .project-image-wrap:hover img {
      transform: scale(1.04); /* natural zoom — shows more, not less */
      opacity: 1;
    }

    /* zoom icon overlay */
    .image-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0,0,0,0);
      transition: background 0.3s;
      border-radius: 18px;
      pointer-events: none;
    }

    .project-image-wrap:hover .image-overlay {
      background: rgba(0,0,0,0.25);
    }

    .zoom-icon {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: rgba(255,255,255,0.15);
      backdrop-filter: blur(6px);
      border: 1px solid rgba(255,255,255,0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transform: scale(0.7);
      transition: opacity 0.3s, transform 0.3s;
      color: #fff;
      font-size: 1.1rem;
    }

    .project-image-wrap:hover .zoom-icon {
      opacity: 1;
      transform: scale(1);
    }

    /* ── MODAL ── */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.88);
      backdrop-filter: blur(8px);
      justify-content: center;
      align-items: center;
      z-index: 999;
      padding: 2rem;
    }

    .modal.show { display: flex; }

    .modal-content {
      max-width: 85%;
      max-height: 85vh;
      object-fit: contain;
      border-radius: 18px;
      box-shadow: 0 30px 80px rgba(0,0,0,0.8);
      transform: scale(0.85);
      opacity: 0;
      transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s;
    }

    .modal.show .modal-content {
      transform: scale(1);
      opacity: 1;
    }

    .modal-close {
      position: fixed;
      top: 1.5rem;
      right: 2rem;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.15);
      color: #fff;
      font-size: 1.4rem;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.2s;
      line-height: 1;
    }

    .modal-close:hover { background: rgba(255,255,255,0.18); }

    /* ── DIVIDER ── */
    .section-divider {
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--border), transparent);
      margin: 1rem 0;
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 820px) {
      .project-card {
        grid-template-columns: 1fr;
        padding: 1.6rem;
        gap: 1.6rem;
      }

      .project-text { order: 1; } /* text on top */
      .project-image-wrap { order: 2; } /* image below */

      /* always keep text on top even for reversed cards */
      .project-card.reverse .project-text { order: 1; }
      .project-card.reverse .project-image-wrap { order: 2; }
    }

    @media (max-width: 480px) {
      h1 { font-size: 2rem; }
      .project-title { font-size: 1.15rem; }
    }
  </style>
</head>

<body>
<div class="container">

  <!-- NAV -->
  <header>
    <nav>
      <div class="nav-container">
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/projects" class="active">Projects</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </div>
      </div>
    </nav>
  </header>

  <!-- MAIN CONTENT -->
  <main>
    <span class="page-badge">✦ Projects</span>
    <h1>Recent Projects</h1>
    <p class="page-desc">
      A curated selection of projects showcasing web development,
      AI systems, and data analysis work.
    </p>

    <div class="projects">

      <!-- ── PROJECT 1 (Z-pattern: image LEFT, text RIGHT) ── -->
      <article class="project-card reverse" id="project-1">

        <!-- TEXT RIGHT (order:2 via .reverse) -->
        <div class="project-text">
          <span class="project-number">Project 01</span>
          <h2 class="project-title">Smart Hotel Booking System with AI Chatbot Integration</h2>

          <div class="project-desc">
            <p>
              A scalable web-based hotel booking platform that enables real-time room reservations
              and intelligent customer support through an AI-powered chatbot. Implemented a dynamic
              booking engine with availability checks and optimised MySQL queries for accurate,
              efficient operations.
            </p>
            <p>
              Designed and developed RESTful APIs using PHP and Flask to enable seamless
              communication between the frontend, backend, and chatbot services.
            </p>
            <p>
              Focused on performance, data synchronisation, and responsive UI design to provide
              a smooth and user-friendly experience across devices.
            </p>
          </div>

          <div class="section-divider"></div>

          <div class="project-tech" aria-label="Tech stack">
            <span class="tech-label">HTML5</span>
            <span class="tech-label">CSS3</span>
            <span class="tech-label">JavaScript</span>
            <span class="tech-label">jQuery</span>
            <span class="tech-label">Bootstrap</span>
            <span class="tech-label">PHP</span>
            <span class="tech-label">Flask</span>
            <span class="tech-label">MySQL</span>
            <span class="tech-label">AJAX</span>
          </div>
        </div>

        <!-- IMAGE RIGHT -->
        <div class="project-image-wrap" role="button" aria-label="Preview chatbot project image" tabindex="0">
          <img src="/images/chatbot.png" alt="Smart Hotel Booking System with AI Chatbot screenshot" loading="lazy" />
          <div class="image-overlay">
            <div class="zoom-icon">⤢</div>
          </div>
        </div>

      </article>

      <!-- ── PROJECT 2 (Z-pattern: text LEFT, image RIGHT) ── -->
      <article class="project-card" id="project-2">

        <!-- IMAGE RIGHT (order:2 default) -->
        <div class="project-image-wrap" role="button" aria-label="Preview PlanPal project image" tabindex="0">
          <img src="/images/planpal.png" alt="PlanPal task management app screenshot" loading="lazy" />
          <div class="image-overlay">
            <div class="zoom-icon">⤢</div>
          </div>
        </div>

        <!-- TEXT LEFT (order:1 default) -->
        <div class="project-text">
          <span class="project-number">Project 02</span>
          <h2 class="project-title">PlanPal</h2>

          <div class="project-desc">
            <p>
              A web-based task management application designed to help users organise daily
              activities and improve productivity. Implemented secure user authentication and
              full CRUD functionality — add, edit, delete, and mark tasks as completed through
              a personalised dashboard.
            </p>
            <p>
              Designed real-time interactions using AJAX and JavaScript to provide instant
              updates without page reloads. Integrated client-side and server-side validation
              using jQuery and PHP (PDO) to ensure data accuracy and secure operations.
            </p>
            <p>
              Focused on responsive UI design and efficient MySQL database handling to deliver
              a smooth, reliable, and user-friendly experience.
            </p>
          </div>

          <div class="section-divider"></div>

          <div class="project-tech" aria-label="Tech stack">
            <span class="tech-label">PHP</span>
            <span class="tech-label">MySQL</span>
            <span class="tech-label">JavaScript</span>
            <span class="tech-label">HTML5</span>
            <span class="tech-label">jQuery</span>
            <span class="tech-label">AJAX</span>
            <span class="tech-label">PDO</span>
            <span class="tech-label">Session Management</span>
          </div>
        </div>

      </article>

      <!-- ── PROJECT 3 (Z-pattern: image LEFT, text RIGHT) ── -->
      <article class="project-card reverse" id="project-3">

        <!-- TEXT RIGHT (order:2 via .reverse) -->
        <div class="project-text">
          <span class="project-number">Project 03</span>
          <h2 class="project-title">Kathmandu Weather Analysis (2015–2025)</h2>

          <div class="project-desc">
            <p>
              An interactive data visualization project focused on analyzing long-term weather patterns in Kathmandu. Converts raw meteorological data into actionable insights by identifying trends in temperature, rainfall, and seasonal variations.
            </p>
            <p>
              Applied a range of visual techniques including line charts, heatmaps, and scatter plots to examine climate patterns and relationships between key variables. Developed an interactive Tableau dashboard with filtering, tooltips, and KPI indicators to support efficient data exploration.
            <p>
              Prioritizes clarity, accuracy, and intuitive design to present complex datasets in a structured and insightful manner, enabling data-driven decision-making.
            </p>
          </div>

          <div class="section-divider"></div>

          <div class="project-tech" aria-label="Tech stack">
            <span class="tech-label">Tableau</span>
            <span class="tech-label">Data Analysis</span>
            <span class="tech-label">Data Cleaning</span>
            <span class="tech-label">Dashboard Design</span>
          </div>
        </div>

        <!-- IMAGE LEFT (order:1 via .reverse) -->
        <div class="project-image-wrap" role="button" aria-label="Preview weather analysis project image" tabindex="0">
          <img src="/images/weather.png" alt="Kathmandu Weather Analysis dashboard screenshot" loading="lazy" />
          <div class="image-overlay">
            <div class="zoom-icon">⤢</div>
          </div>
        </div>

      </article>

    </div>
  </main>

</div>

<!-- MODAL LIGHTBOX -->
<div class="modal" id="modal" role="dialog" aria-modal="true" aria-label="Image preview">
  <button class="modal-close" id="modalClose" aria-label="Close preview">✕</button>
  <img class="modal-content" id="modalImg" src="" alt="Project preview" />
</div>

<script>
  /* ── Scroll-reveal ── */
  const cards = document.querySelectorAll('.project-card');
  const reveal = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('show');
        reveal.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });
  cards.forEach(card => reveal.observe(card));

  /* ── Lightbox ── */
  const modal    = document.getElementById('modal');
  const modalImg = document.getElementById('modalImg');
  const closeBtn = document.getElementById('modalClose');

  function openModal(src, alt) {
    modalImg.src = src;
    modalImg.alt = alt;
    modal.classList.add('show');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.remove('show');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.project-image-wrap').forEach(wrap => {
    const img = wrap.querySelector('img');
    wrap.addEventListener('click', () => openModal(img.src, img.alt));
    wrap.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') openModal(img.src, img.alt);
    });
  });

  closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
</script>

</body>
</html>
